# Generate values with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('choose-a-strong-password', method='pbkdf2:sha256'))"
SECRET_KEY=replace-with-a-random-secret
AUTH_USERNAME=your-username
AUTH_PASSWORD_HASH=replace-with-a-werkzeug-password-hash

# Keep false for local http://127.0.0.1 development. Set true behind HTTPS.
SESSION_COOKIE_SECURE=false

# ntfy.sh push notifications (install the ntfy app on your iPhone and
# subscribe to this topic; pick a unique, hard-to-guess topic name)
NTFY_TOPIC=your-unique-sproutz-topic

# Azure Blob Storage for private plant photos
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_CONTAINER=plant-images
